/.task/

/attic/
/dist/
/reference/
/strument
/strumentrec
/strument-subset

# The Monty shim's Rust build output (internal/monty/shim/target), not to be
# confused with the checked-in blob it produces.
/internal/monty/shim/target/

*.bak
*.sw*

# Trial binaries and Python caches under doc/experiments: a trial builds one
# binary per arm to compare them, and those are build output, not data. The
# runner and its results.jsonl are what get committed.
/doc/experiments/*/bin/
__pycache__/
