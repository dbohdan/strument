--- new file: internal/coder/tasklist.go
package coder

import (
	"encoding/json"
	"fmt"
	"strings"

	"dbohdan.com/strument/internal/llm"
)

// TRIAL PROTOTYPE (doc/experiments/2026-09-task-checklist): a short checklist
// the model may keep for a turn, visible to the user as it changes and
// recorded in the session log. Offered without any mention outside its own
// description: no system-prompt line, no reminders.
const toolTask = "task"

const taskMaxItems = 12

type taskItem struct {
	Subject string
	Status  string // pending, in_progress, done, dropped
}

func taskTool() llm.ToolDef {
	return llm.ToolDef{
		Name: toolTask,
		Description: "Keep a short checklist of this turn's work, which the user sees as it changes. " +
			"Add the parts of a request as items, then set each to in_progress and to done as you go, " +
			"or to dropped, saying why in your answer. Every call returns the whole list. " +
			"At most 12 items. Optional: for a request with several parts.",
		Parameters: map[string]any{
			"type": "object",
			"properties": map[string]any{
				"add": map[string]any{
					"type":        "array",
					"items":       map[string]any{"type": "string"},
					"description": "Subjects of new items, each a short imperative phrase.",
				},
				"set": map[string]any{
					"type": "array",
					"items": map[string]any{
						"type": "object",
						"properties": map[string]any{
							"id":     map[string]any{"type": "integer", "description": "The item's number, from 1."},
							"status": map[string]any{"type": "string", "enum": []any{"pending", "in_progress", "done", "dropped"}},
						},
						"required": []any{"id", "status"},
					},
					"description": "Status changes for existing items.",
				},
			},
		},
	}
}

var taskMarks = map[string]string{"pending": "[ ]", "in_progress": "[~]", "done": "[x]", "dropped": "[-]"}

func (c *Coder) renderTasks() string {
	var b strings.Builder
	for i, t := range c.tasks {
		fmt.Fprintf(&b, "%d. %s %s\n", i+1, taskMarks[t.Status], t.Subject)
	}
	return b.String()
}

func (c *Coder) runTask(tc llm.ToolCall) string {
	var args struct {
		Add []string `json:"add"`
		Set []struct {
			ID     int    `json:"id"`
			Status string `json:"status"`
		} `json:"set"`
	}
	if err := json.Unmarshal([]byte(tc.Arguments), &args); err != nil {
		return "The arguments were not valid JSON, so the list is unchanged."
	}
	var problems []string
	for _, s := range args.Add {
		s = strings.TrimSpace(s)
		if s == "" {
			continue
		}
		if len(c.tasks) >= taskMaxItems {
			problems = append(problems, fmt.Sprintf("not added, the list holds %d items: %q", taskMaxItems, s))
			continue
		}
		c.tasks = append(c.tasks, taskItem{Subject: s, Status: "pending"})
		c.Out.Toolf("Task %d added: %s", len(c.tasks), s)
	}
	for _, u := range args.Set {
		if u.ID < 1 || u.ID > len(c.tasks) {
			problems = append(problems, fmt.Sprintf("no item %d", u.ID))
			continue
		}
		if _, ok := taskMarks[u.Status]; !ok {
			problems = append(problems, fmt.Sprintf("unknown status %q for item %d", u.Status, u.ID))
			continue
		}
		c.tasks[u.ID-1].Status = u.Status
		c.Out.Toolf("Task %d %s: %s", u.ID, strings.ReplaceAll(u.Status, "_", " "), c.tasks[u.ID-1].Subject)
	}
	list := c.renderTasks()
	c.record(Record{Type: "task", ToolCallID: tc.ID, Summary: list})
	out := list
	if out == "" {
		out = "The list is empty.\n"
	}
	if len(problems) > 0 {
		out += "\nNot applied: " + strings.Join(problems, "; ") + "."
	}
	return out
}
