+// trialID rewrites a tool-call ID when STRUMENT_TRIAL_REWRITE_IDS is set.
+// Trial build only (doc/experiments/2026-11-preserved-reasoning, phase 4): a
+// route that re-inserts stored reasoning for its own call IDs cannot match a
+// rewritten one, so the arm sends no reasoning at all. The rewrite is
+// deterministic, so the prefix stays the same from request to request.
+func trialID(id string) string {
+	if id == "" || os.Getenv("STRUMENT_TRIAL_REWRITE_IDS") == "" {
+		return id
+	}
+	sum := sha256.Sum256([]byte(id))
+	return "call_t" + hex.EncodeToString(sum[:8])
+}
