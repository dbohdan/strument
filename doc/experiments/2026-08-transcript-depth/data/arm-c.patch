diff --git a/internal/coder/toollog.go b/internal/coder/toollog.go
index 7957b2a..6d72135 100644
--- a/internal/coder/toollog.go
+++ b/internal/coder/toollog.go
@@ -89,3 +89,27 @@ func (c *Coder) TurnToolLines() []string {
 	}
 	return c.toolLog.recorded()
 }
+
+// maxTurnReasoning caps the reasoning kept for one turn.
+//
+// Per turn rather than per session: one thinky turn would otherwise consume a
+// whole session's record. The *tail* is kept, not the head — reasoning is
+// conclusion-last, so head-truncation keeps the exploration and drops the
+// finding, which is exactly inverted. The elision is marked, because a
+// mid-truncated trace that reads as complete is worse than none.
+const maxTurnReasoning = 1500
+
+// TurnReasoning returns the turn's reasoning, tail-truncated. Same lifetime
+// rule as TurnEditedFiles and TurnToolLines.
+func (c *Coder) TurnReasoning() string {
+	r := strings.TrimSpace(c.turnReasoning)
+	if len(r) <= maxTurnReasoning {
+		return r
+	}
+	r = r[len(r)-maxTurnReasoning:]
+	// Snap forward to a line break so the kept part starts on a whole thought.
+	if i := strings.IndexByte(r, '\n'); i >= 0 && i < 200 {
+		r = r[i+1:]
+	}
+	return "(Earlier reasoning omitted.)\n" + r
+}
