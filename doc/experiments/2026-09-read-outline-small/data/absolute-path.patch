+// An absolute path inside the project outlines like a relative one.
+func TestOutlineTakesAnAbsolutePath(t *testing.T) {
+	withReadArm(t, "C")
+	c, _ := observeEnv(t, map[string]string{"m.py": outlineFile(30)})
+	got := readTool(c, call("read", `{"path":`+jsonString(filepath.Join(c.Root, "m.py"))+`,"outline":true}`))
+	if !strings.Contains(got, "- class Store  [31-33]") {
+		t.Errorf("an absolute path lost the outline:\n%s", got)
+	}
+}
